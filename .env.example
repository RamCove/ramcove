# Copy to .env for local development. Contains no real secrets.
RAMCOVE_ENV=demo                      # demo | local | testnet (mainnet is refused by this build)
RAMCOVE_DATABASE_URL=postgresql+psycopg://ramcove:ramcove-local-dev-only@127.0.0.1:54329/ramcove
RAMCOVE_TEST_DATABASE_URL=postgresql+psycopg://ramcove:ramcove-local-dev-only@127.0.0.1:54329/ramcove_test
RAMCOVE_PUBLIC_ORIGIN=http://localhost:3787
RAMCOVE_API_ORIGIN=http://localhost:8787
RAMCOVE_ARTIFACT_DIR=var/artifacts
# Service signing key seed for receipts in demo mode only (deterministic dev key; never use on a real network)
RAMCOVE_DEMO_SERVICE_KEY_URI=//RamCoveDemoIntake
