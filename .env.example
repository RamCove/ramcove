# Copy to .env for local development. Contains no real secrets.
ROOM_ENV=demo                      # demo | local | testnet (mainnet is refused by this build)
ROOM_DATABASE_URL=postgresql+psycopg://room:room-local-dev-only@127.0.0.1:54329/room
ROOM_TEST_DATABASE_URL=postgresql+psycopg://room:room-local-dev-only@127.0.0.1:54329/room_test
ROOM_PUBLIC_ORIGIN=http://localhost:3787
ROOM_API_ORIGIN=http://localhost:8787
ROOM_ARTIFACT_DIR=var/artifacts
# Service signing key seed for receipts in demo mode only (deterministic dev key; never use on a real network)
ROOM_DEMO_SERVICE_KEY_URI=//RoomDemoIntake
