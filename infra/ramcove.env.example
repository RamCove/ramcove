# /etc/ramcove/ramcove.env on the public demo host (mode 600). No secrets live here.
RAMCOVE_ENV=demo
# Web deployments allowed to send state-changing requests through their proxy.
RAMCOVE_ALLOWED_ORIGINS=http://localhost:3787,https://ramcove.vercel.app
# Public demo: a labelled stand-in reviewer approves after this many seconds (0 = people only).
RAMCOVE_DEMO_AUTO_REVIEW_S=120
RAMCOVE_GUEST_LIMIT_PER_HOUR=120
