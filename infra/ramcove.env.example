# /etc/ramcove/ramcove.env on the public demo host (mode 600). No secrets live here.
RAMCOVE_ENV=demo
# Browser origins allowed to send state-changing requests. The site itself sends none, and the
# command-line tools send no origin at all, so this only has to name the local site.
RAMCOVE_ALLOWED_ORIGINS=http://localhost:3787
# Public demo: a labelled stand-in reviewer approves after this many seconds (0 = people only).
RAMCOVE_DEMO_AUTO_REVIEW_S=120
