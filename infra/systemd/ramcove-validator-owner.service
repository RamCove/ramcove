[Unit]
Description=RamCove owner-operated validator (demo): submits the weights its own evaluation produced
After=ramcove-api.service
Wants=ramcove-api.service

[Service]
Type=simple
WorkingDirectory=/root/draven/room
ExecStart=/root/draven/room/.venv/bin/ramcove-validator --api http://127.0.0.1:8787 --key-uri //RamCoveDemoValidatorOperator --state /var/lib/ramcove/validator-owner.json
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
